# Variables read by docker-compose.yml. Copy to .env next to it; never commit .env.
# Local development without Docker uses backend/.env instead (see backend/.env.example).

# Required
SECRET_KEY=
POSTGRES_PASSWORD=

# Public URLs. Behind a proxy, use your real hostnames (https:// and wss://).
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
PUBLIC_WS_URL=ws://localhost:8000
API_HOSTNAME=localhost
# Set when the dashboard and API share a parent domain, for example .helploom.example
REFRESH_COOKIE_DOMAIN=
# true behind a TLS proxy; false for a plain HTTP trial on one machine.
SECURE_SSL_REDIRECT=true
TRUSTED_PROXY_COUNT=1

# Answers: auto | ollama | claude | extractive
LLM_PROVIDER=auto
EMBEDDER=auto
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Billing (empty key = demo billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Email (console backend prints invitation emails to the backend log)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Helploom <no-reply@helploom.local>
