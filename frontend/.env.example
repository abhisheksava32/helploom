# Helploom dashboard configuration. Copy to frontend/.env.local for local overrides.
# NEXT_PUBLIC_ values are inlined into the browser bundle, so never put secrets here.

# Django backend origin (REST lives under /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Websocket origin; differs from the API origin behind some proxies.
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Public origin of this dashboard, used for absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: a widget site key from a demo workspace. When set, the landing page
# loads the real widget so visitors can chat with that workspace's documents.
NEXT_PUBLIC_DEMO_SITE_KEY=
