# Helploom backend configuration. Copy to backend/.env for local development:
#   cp backend/.env.example backend/.env
# Real environment variables override values in .env. Never commit .env.

# Core
DEBUG=true
# Required when DEBUG is false. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
PUBLIC_WS_URL=ws://localhost:8000
LOG_LEVEL=INFO

# Database (PostgreSQL with the pgvector extension available)
DATABASE_URL=postgres://localhost:5432/helploom
DB_CONN_MAX_AGE=0
# Optional; pytest-django uses test_<database name> by default.
DATABASE_TEST_NAME=

# Browser access. Comma separated origins. Default to FRONTEND_URL.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Auth
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
# Defaults to SECRET_KEY.
JWT_SIGNING_KEY=
# Set when the dashboard and API share a parent domain, for example .helploom.example
REFRESH_COOKIE_DOMAIN=
# Defaults to true when DEBUG is false.
REFRESH_COOKIE_SECURE=
INVITATION_EXPIRY_DAYS=7

# Rate limits (DRF throttle syntax)
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_UPLOAD=30/min
THROTTLE_WEBHOOK=120/min
THROTTLE_WIDGET=120/min
# Reverse proxies in front of the app. Rate limits (REST and websockets) trust only
# that many X-Forwarded-For hops; 0 uses the socket address, so clients cannot spoof it.
TRUSTED_PROXY_COUNT=0

# Uploads
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=10
MEDIA_ROOT=

# Real time, cache and background jobs. Leave empty locally: an in-memory channel
# layer, the local memory cache and a thread pool are used instead.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_TIME_LIMIT=900
CELERY_TASK_SOFT_TIME_LIMIT=840
BACKGROUND_TASKS_EAGER=false
INGESTION_MAX_WORKERS=2
WEBSOCKET_AUTH_TIMEOUT_SECONDS=10

# Answer providers: auto | ollama | claude | extractive
# auto uses Ollama when reachable, else the offline extractive mode.
LLM_PROVIDER=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CONNECT_TIMEOUT_SECONDS=2
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=10m
PROVIDER_PROBE_TTL_SECONDS=30

# Claude API. Only used when LLM_PROVIDER=claude and a key is set. The SDK reads the
# key from the environment; it is never stored in the database or logged.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FALLBACK_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=4096
CLAUDE_EFFORT=low
CLAUDE_TIMEOUT_SECONDS=60

# Embeddings and retrieval: auto | ollama | hashing
EMBEDDER=auto
EMBEDDING_BATCH_SIZE=32
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=24
RRF_K=60
RETRIEVAL_MMR=true
RETRIEVAL_MMR_LAMBDA=0.7
HNSW_EF_SEARCH=80
# Empty uses the active embedder's calibrated default; a number overrides it.
RELEVANCE_THRESHOLD=

# Assistant
ASSISTANT_HISTORY_TURNS=6
ASSISTANT_MAX_QUESTION_CHARS=2000
ASSISTANT_EXTRACTIVE_MAX_SENTENCES=4

# Website widget
WIDGET_MESSAGES_PER_MINUTE=20
WIDGET_CONNECTIONS_PER_MINUTE=30
WIDGET_ALLOW_LOCALHOST_IN_DEBUG=true

# Billing. Leave STRIPE_SECRET_KEY empty for demo billing (plans switch instantly).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Email. The console backend prints invitation emails to the server log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Helploom <no-reply@helploom.local>

# Production hardening overrides. Defaults follow DEBUG.
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
